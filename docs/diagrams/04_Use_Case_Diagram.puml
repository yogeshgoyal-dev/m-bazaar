@startuml
' ==========================================================
' USE CASE DIAGRAM
' E-Commerce Shopping Cart System
' ==========================================================
left to right direction
skinparam linetype ortho

actor "Customer" as Customer
actor "Admin" as Admin

rectangle "E-Commerce System" {
  usecase "Register / Login" as UC1
  usecase "Browse Categories\n& Products" as UC2
  usecase "Search / Filter Products" as UC3
  usecase "View Product Details" as UC4
  usecase "Add to Cart" as UC5
  usecase "Update / Remove Cart Item" as UC6
  usecase "Checkout (COD)" as UC7
  usecase "View My Orders" as UC8
  usecase "Cancel Order" as UC9
  usecase "Manage Products" as UC10
  usecase "Manage Categories" as UC11
  usecase "View All Orders" as UC12
  usecase "Update Order Status" as UC13
}

Customer --> UC1
Customer --> UC2
Customer --> UC3
Customer --> UC4
Customer --> UC5
Customer --> UC6
Customer --> UC7
Customer --> UC8
Customer --> UC9

Admin --> UC1
Admin --> UC10
Admin --> UC11
Admin --> UC12
Admin --> UC13

UC5 ..> UC6 : <<extend>>
UC7 ..> UC5 : <<include>>
UC8 ..> UC9 : <<extend>>
@enduml