@startuml
' ==========================================================
' DFD LEVEL 1
' E-Commerce Shopping Cart System
' ==========================================================
skinparam linetype ortho

actor "Customer" as Customer
actor "Admin" as Admin

rectangle "1.0\nUser\nManagement" as P1
rectangle "2.0\nProduct\nCatalog" as P2
rectangle "3.0\nCart\nManagement" as P3
rectangle "4.0\nOrder\nProcessing" as P4

database "D1\nMySQL Database" as D1

Customer --> P1 : Registration / Login
P1 --> Customer : Auth Token

Customer --> P2 : Browse / Search
P2 --> Customer : Product Details

Customer --> P3 : Add / Update / Remove
P3 --> Customer : Cart Summary

Customer --> P4 : Checkout (COD)\nCancel Order
P4 --> Customer : Order Confirmation

Admin --> P2 : Add / Update / Delete
Admin --> P4 : Update Order Status

P1 --> D1 : users
P2 --> D1 : products, categories
P3 --> D1 : cart
P4 --> D1 : orders, order_items

D1 --> P3 : cart data
D1 --> P4 : order data
@enduml